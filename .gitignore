# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# DB
/API/appsettings.Development.json

## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Rider / JetBrains IDE
.idea/

# Visual Studio Code
.vscode/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Auto-generated files
*.cache
*.pdb
*.obj
*.dll
*.exe
*.tmp
*.bak


# Azure build output
csx/
*.build.csdef

# Publish output
*.pubxml
*.publishproj

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Tye
.tye/

# Generated project files
project.lock.json
project.fragment.lock.json
artifacts/

# Optional: ignore test result output
TestResults/
*.trx
*.coverage
*.coveragexml

# dotnet user secrets
secrets.json

# Local environment files
.env
.env.*

# Others
*.dbmdl
*.bak
*.log
*.dmp

# JetBrains Rider
.idea/

# Backup & auto save
*~*
*.swp
*.swo
*.tmp
*.temp

# Visual Studio for Mac
.vscode/
*.pidb
*.userprefs

# Microsoft auto-generated folder
.vs/
